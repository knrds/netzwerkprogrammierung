{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Make: UDP",
      "type": "process",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/P1/udp_examples"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Make: UDP-Lite",
      "type": "process",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/P1/udplite_examples"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Make: TCP",
      "type": "process",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/P2/tcp_examples"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Make: alle",
      "dependsOn": [
        "Make: UDP",
        "Make: UDP-Lite",
        "Make: TCP"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
